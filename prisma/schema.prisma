generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  picture       String?
  isDemo        Boolean        @default(false)
  accessToken   String?
  refreshToken  String?
  tokenExpiry   DateTime?
  theme         String         @default("woodland") // woodland | georgian | pixel | dev
  createdAt     DateTime       @default(now())
  workspaces    Workspace[]
  emails        Email[]
  laneTemplates LaneTemplate[]
  activity      Activity[]
  tasks         Task[]
}

// One workspace per Gmail label (INBOX included), created the first time the
// label is opened. Gmail is the source of truth for which emails belong to it.
model Workspace {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  labelId    String
  name       String // the label's name when the workspace was created
  createdAt  DateTime    @default(now())
  lanes      Lane[]
  placements Placement[]
  tickets    Email[] // tickets made in this workspace that have no email
  activity   Activity[]

  @@unique([userId, labelId])
}

// A column the user adds to sort a workspace's emails. Workspaces start with none.
model Lane {
  id            String      @id @default(cuid())
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  position      Int         @default(0)
  reopenOnReply Boolean     @default(false) // a new reply sends the email back to unsorted
  placements    Placement[]

  @@index([workspaceId])
}

// A set of lanes the user saved to start other workspaces with.
model LaneTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  lanes     Json // [{ name, reopenOnReply }] in order
  createdAt DateTime @default(now())

  @@index([userId])
}

// An email thread the app knows about: the ticket itself. Notes and tasks hang
// off it and follow it into every workspace it appears in.
// A ticket with no email has a "local:" threadId and lives in one workspace.
model Email {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String? // set only for tickets with no email
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  threadId    String
  subject     String
  from        String
  snippet     String
  date        DateTime // latest message when last refreshed
  lastSeenAt  DateTime? // latest message the user has opened; newer means a new reply
  createdAt   DateTime     @default(now())
  notes       Note[]
  tasks       Task[]
  links       TicketLink[]
  placements  Placement[]
  activity    Activity[]

  @@unique([userId, threadId])
  @@index([workspaceId])
}

// Where an email sits in one workspace. No placement means it's unsorted.
model Placement {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  laneId      String
  lane        Lane      @relation(fields: [laneId], references: [id], onDelete: Cascade)
  emailId     String
  email       Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)
  position    Int       @default(0)

  @@unique([workspaceId, emailId])
  @@index([laneId])
}

model Note {
  id        String   @id @default(cuid())
  emailId   String
  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([emailId])
}

// A link kept with a ticket: a shared doc, a design, a quote, an order page.
model TicketLink {
  id        String   @id @default(cuid())
  emailId   String
  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  url       String
  title     String   @default("")
  createdAt DateTime @default(now())

  @@index([emailId])
}

// A to-do: on an email or ticket, or on its own (emailId null) from My tasks.
model Task {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailId   String?
  email     Email?    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  title     String
  notes     String    @default("")
  done      Boolean   @default(false)
  dueDate   DateTime?
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([emailId])
  @@index([userId])
}

// What the user did, newest first on the dashboard. kind: moved | ticket | task | taskDone | note.
// detail is the lane name for "moved" (empty = back to unsorted) or the task's title.
model Activity {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailId     String?
  email       Email?     @relation(fields: [emailId], references: [id], onDelete: Cascade)
  kind        String
  detail      String     @default("")
  createdAt   DateTime   @default(now())

  @@index([userId, createdAt])
}
