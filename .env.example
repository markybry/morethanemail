# Copy to .env for local dev. On Vercel, set these in Project Settings -> Environment Variables.
# Tip: once the Vercel project is linked, `vercel env pull .env` fills most of these in.

# Postgres (added automatically by the Prisma Postgres integration on Vercel).
# Use the direct postgres:// connection string, not the prisma+postgres:// Accelerate one.
DATABASE_URL="postgres://user:pass@db.prisma.io:5432/postgres?sslmode=require"

# Signs the login cookie. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Leave blank to run in demo mode with sample emails.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated list of Google accounts allowed to sign in. Blank = anyone with a Google account.
ALLOWED_EMAILS="markybry@gmail.com"

# Public URL of the app, used for the OAuth redirect. Defaults to the Vercel production URL, or localhost:3000.
# APP_URL="https://your-app.vercel.app"

# Set to "true" to show the demo button even when Google sign-in is configured.
# ENABLE_DEMO="false"
